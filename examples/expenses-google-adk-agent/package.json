{
  "name": "expenses-google-adk-agent",
  "version": "1.0.0",
  "description": "A Google ADK (TypeScript) Custom Agent template, served over A2A, that uses Workday Agent Harness for model inference, Workday tools, and sessions",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.14",
    "@google/adk": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
