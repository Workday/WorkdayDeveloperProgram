---
import TypeIcon from "./TypeIcon.astro";
import { withBase, sourceLabel, downloadUrl, downloadName } from "../lib/examples.js";

const { example } = Astro.props;
const detailUrl = withBase(`${example.path}/`);
const badge = sourceLabel(example);
const tags = [...new Set([example.type, ...example.components, ...example.products])];
const searchText = [example.title, example.description, example.id, example.type, badge, ...example.components, ...example.products]
  .join(" ")
  .toLowerCase();
---
{/* The title link is stretched over the whole card (after:inset-0), so the
    card stays one click target while the download link sits above it. */}
<div
  class="example-card group relative flex flex-col gap-3 rounded-xl border border-neutral-200 bg-white p-5 transition-colors hover:border-neutral-400 focus-within:border-neutral-400 dark:border-neutral-800 dark:bg-neutral-950 dark:hover:border-neutral-500 dark:focus-within:border-neutral-500"
  data-section={example.section}
  data-type={example.type}
  data-components={example.components.join("|")}
  data-products={example.products.join("|")}
  data-source={badge}
  data-search={searchText}
>
  <div class="flex items-center justify-between">
    <TypeIcon type={example.type} />
    <div class="flex items-center gap-2">
      {badge === "Workday" ? (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-wd-blue/10 px-2.5 py-1 text-xs font-semibold text-wd-blue">
          <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          Workday
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 px-2.5 py-1 text-xs font-medium text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
          <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          Community
        </span>
      )}
      <a
        href={downloadUrl(example)}
        download={downloadName(example)}
        title="Download zip"
        aria-label={`Download ${example.title} as a zip`}
        class="relative z-10 flex h-7 w-7 items-center justify-center rounded-md text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:hover:bg-neutral-900 dark:hover:text-neutral-100"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
          <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
        </svg>
      </a>
    </div>
  </div>
  <h2 class="text-base font-semibold tracking-tight">
    <a href={detailUrl} class="after:absolute after:inset-0 after:content-[''] focus:outline-none">{example.title}</a>
  </h2>
  <p class="flex-1 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">{example.description}</p>
  <div class="flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
        {tag}
      </span>
    ))}
  </div>
</div>
