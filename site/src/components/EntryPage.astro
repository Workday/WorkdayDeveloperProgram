---
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { config, withBase, sourceLabel, downloadUrl, downloadName, sparseCheckout } from "../lib/examples.js";

const { example } = Astro.props;

const readmes = {
  ...import.meta.glob("../../../catalog/*/README.md", { eager: true }),
  ...import.meta.glob("../../../examples/*/README.md", { eager: true })
};
const readme = Object.entries(readmes).find(([path]) => path.endsWith(`/${example.path}/README.md`))?.[1];
const Content = readme?.Content;
const headings = (readme?.getHeadings?.() ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 3);

const codeUrl = `${config.repoUrl}/tree/${config.defaultBranch}/${example.path}`;
const contributeUrl = `${config.repoUrl}/blob/${config.defaultBranch}/CONTRIBUTING.md`;
const tags = [...new Set([example.type, ...example.components, ...example.products])];
const badge = sourceLabel(example);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{example.title} | Workday Developer Program</title>
    <meta name="description" content={example.description} />
    <link rel="icon" type="image/png" href={withBase("favicon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-neutral-900 antialiased dark:bg-black dark:text-neutral-100">
    <Header repoUrl={config.repoUrl} />

    <main class="mx-auto w-full max-w-7xl flex-1 px-6 py-12">
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-neutral-200 pb-8 dark:border-neutral-800">
        <div class="flex min-w-0 items-start gap-4">
          <a
            href={withBase("")}
            aria-label="Back to all examples"
            class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-neutral-200 text-neutral-600 transition-colors hover:bg-neutral-100 dark:border-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-900"
          >
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 8H3M7 3.5 2.5 8 7 12.5"></path>
            </svg>
          </a>
          <div class="min-w-0">
            <p class="mb-1.5 text-xs">
              <a
                href={withBase(`?section=${example.section === "App catalog" ? "catalog" : "examples"}`)}
                class="font-medium text-wd-blue hover:underline"
              >
                {example.section}
              </a>
              <span class="text-neutral-400 dark:text-neutral-600"> / {example.id}</span>
            </p>
            <div class="flex flex-wrap items-center gap-3">
              <h1 class="text-3xl font-bold tracking-tight">{example.title}</h1>
              {badge === "Workday" ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-wd-blue/10 px-2.5 py-1 text-xs font-semibold text-wd-blue">
                  <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="m9 12 2 2 4-4"></path>
                  </svg>
                  Workday
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 px-2.5 py-1 text-xs font-medium text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
                  <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  Community
                </span>
              )}
            </div>
            <p class="mt-2 text-[15px] text-neutral-500 dark:text-neutral-400">{example.description}</p>
            <div class="mt-3.5 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2.5">
          {example.tutorial && (
            <a
              href={example.tutorial}
              target="_blank"
              rel="noopener"
              class="rounded-md border border-neutral-200 px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-100 dark:border-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-900"
            >
              Tutorial
            </a>
          )}
          <a
            href={codeUrl}
            target="_blank"
            rel="noopener"
            class="rounded-md border border-neutral-200 px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-100 dark:border-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-900"
          >
            View code
          </a>
          <a
            href={downloadUrl(example)}
            download={downloadName(example)}
            class="inline-flex items-center gap-2 rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-white dark:text-black dark:hover:bg-neutral-200"
          >
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
            </svg>
            Download zip
          </a>
        </div>
      </div>

      <details class="mt-6 rounded-lg border border-neutral-200 dark:border-neutral-800">
        <summary class="cursor-pointer select-none px-4 py-3 text-sm font-medium text-neutral-700 dark:text-neutral-300">
          Get it with git instead
        </summary>
        <div class="border-t border-neutral-200 px-4 py-4 dark:border-neutral-800">
          <p class="text-sm text-neutral-500 dark:text-neutral-400">
            Check out only this folder and keep the git history, so you can open a pull request from the same checkout.
            See the <a href={contributeUrl} target="_blank" rel="noopener" class="text-wd-blue hover:underline">contribution guide</a>.
          </p>
          <div class="relative mt-3">
            <pre class="overflow-x-auto rounded-md bg-neutral-100 p-4 pr-24 text-[13px] leading-relaxed text-neutral-800 dark:bg-neutral-900 dark:text-neutral-200"><code id="sparse-checkout">{sparseCheckout(example)}</code></pre>
            <button
              type="button"
              id="copy-sparse-checkout"
              class="absolute right-2 top-2 rounded-md border border-neutral-200 bg-white px-2.5 py-1 text-xs font-medium text-neutral-700 transition-colors hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800"
            >
              Copy
            </button>
          </div>
          <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">
            The zip carries the same trail: its <code>SOURCE.md</code> records the commit it was built from and these commands.
          </p>
        </div>
      </details>

      <div class="mt-10 flex flex-col gap-12 lg:flex-row">
        <article class="prose prose-neutral min-w-0 max-w-3xl flex-1 dark:prose-invert prose-headings:scroll-mt-24 prose-headings:font-semibold prose-headings:tracking-tight">
          {Content ? <Content /> : <p>This example has no README yet.</p>}
        </article>

        {headings.length > 0 && (
          <nav class="hidden w-52 shrink-0 lg:block" aria-label="Table of contents">
            <div class="sticky top-8">
              <p class="text-sm font-medium">On this page</p>
              <ul class="mt-3 space-y-2 border-l border-neutral-200 dark:border-neutral-800">
                {headings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class={`block border-l-2 border-transparent pl-4 text-[13px] text-neutral-500 transition-colors hover:border-neutral-400 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 ${heading.depth === 3 ? "pl-7" : ""}`}
                      style={{ marginLeft: "-1px" }}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )}
      </div>
    </main>

    <Footer contributeUrl={contributeUrl} />

    <script>
      const copyButton = document.getElementById("copy-sparse-checkout");
      const snippet = document.getElementById("sparse-checkout");
      copyButton?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(snippet?.textContent ?? "");
          copyButton.textContent = "Copied";
        } catch {
          // Clipboard blocked: select the snippet so a manual copy works.
          if (snippet) {
            const range = document.createRange();
            range.selectNodeContents(snippet);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
          copyButton.textContent = "Selected";
        }
        setTimeout(() => (copyButton.textContent = "Copy"), 1500);
      });
    </script>
  </body>
</html>
