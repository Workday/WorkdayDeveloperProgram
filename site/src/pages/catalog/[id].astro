---
import EntryPage from "../../components/EntryPage.astro";
import { examples } from "../../lib/examples.js";

export function getStaticPaths() {
  return examples
    .filter((example) => example.section === "App catalog")
    .map((example) => ({ params: { id: example.id }, props: { example } }));
}

const { example } = Astro.props;
---

<EntryPage example={example} />
