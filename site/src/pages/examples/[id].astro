---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { examples, config, withBase } from "../../lib/examples.js";

export function getStaticPaths() {
  return examples.map((example) => ({ params: { id: example.id }, props: { example } }));
}

const { example } = Astro.props;
const readmes = import.meta.glob("../../../../examples/*/README.md", { eager: true });
const readme = Object.entries(readmes).find(([path]) => path.endsWith(`/${example.id}/README.md`))?.[1];
const Content = readme?.Content;
const headings = (readme?.getHeadings?.() ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 3);

const codeUrl = `${config.repoUrl}/tree/${config.defaultBranch}/${example.path}`;
const contributeUrl = `${config.repoUrl}/blob/${config.defaultBranch}/CONTRIBUTING.md`;
const tags = [...new Set([example.type, ...example.components, ...example.products])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{example.title} | Workday Use Case Hub</title>
    <meta name="description" content={example.description} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-neutral-900 antialiased dark:bg-black dark:text-neutral-100">
    <Header repoUrl={config.repoUrl} />

    <main class="mx-auto w-full max-w-7xl flex-1 px-6 py-12">
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-neutral-200 pb-8 dark:border-neutral-800">
        <div class="flex min-w-0 items-start gap-4">
          <a
            href={withBase("")}
            aria-label="Back to all examples"
            class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-neutral-200 text-neutral-600 transition-colors hover:bg-neutral-100 dark:border-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-900"
          >
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 8H3M7 3.5 2.5 8 7 12.5"></path>
            </svg>
          </a>
          <div class="min-w-0">
            <h1 class="text-3xl font-bold tracking-tight">{example.title}</h1>
            <p class="mt-2 text-[15px] text-neutral-500 dark:text-neutral-400">{example.description}</p>
            <div class="mt-3.5 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
        <div class="flex shrink-0 gap-2.5">
          {example.tutorial && (
            <a
              href={example.tutorial}
              target="_blank"
              rel="noopener"
              class="rounded-md border border-neutral-200 px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-100 dark:border-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-900"
            >
              Tutorial
            </a>
          )}
          <a
            href={codeUrl}
            target="_blank"
            rel="noopener"
            class="rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-white dark:text-black dark:hover:bg-neutral-200"
          >
            View code
          </a>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-12 lg:flex-row">
        <article class="prose prose-neutral min-w-0 max-w-3xl flex-1 dark:prose-invert prose-headings:scroll-mt-24 prose-headings:font-semibold prose-headings:tracking-tight">
          {Content ? <Content /> : <p>This example has no README yet.</p>}
        </article>

        {headings.length > 0 && (
          <nav class="hidden w-52 shrink-0 lg:block" aria-label="Table of contents">
            <div class="sticky top-8">
              <p class="text-sm font-medium">On this page</p>
              <ul class="mt-3 space-y-2 border-l border-neutral-200 dark:border-neutral-800">
                {headings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class={`block border-l-2 border-transparent pl-4 text-[13px] text-neutral-500 transition-colors hover:border-neutral-400 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 ${heading.depth === 3 ? "pl-7" : ""}`}
                      style={{ marginLeft: "-1px" }}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )}
      </div>
    </main>

    <Footer contributeUrl={contributeUrl} />
  </body>
</html>
