---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Card from "../components/Card.astro";
import Footer from "../components/Footer.astro";
import FilterGroup from "../components/FilterGroup.astro";
import { examples, types, componentsInUse, productsInUse, config, withBase } from "../lib/examples.js";

const contributeUrl = `${config.repoUrl}/blob/${config.defaultBranch}/CONTRIBUTING.md`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Workday Use Case Hub</title>
    <meta name="description" content="Working examples for Workday Build. Browse, copy, run, and contribute." />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-neutral-900 antialiased dark:bg-black dark:text-neutral-100">
    <Header repoUrl={config.repoUrl} />

    <main class="mx-auto w-full max-w-7xl flex-1 px-6 py-12">
      <h1 class="text-4xl font-bold tracking-tight">Examples and usecases</h1>
      <p class="mt-2 text-neutral-500 dark:text-neutral-400">Working examples for Workday Developer Relations. Copy, run, contribute.</p>
      

      <div class="mt-10 flex flex-col gap-10 lg:flex-row">
        <aside class="w-full shrink-0 lg:w-52">
          <div class="lg:sticky lg:top-8">
            <p id="result-count" class="text-sm text-neutral-500 dark:text-neutral-400" aria-live="polite"></p>
            <div class="mt-6 space-y-7">
              <FilterGroup label="Type" name="type" options={types} />
              <FilterGroup label="Technology" name="component" options={componentsInUse} />
              <FilterGroup label="Product" name="product" options={productsInUse} />
            </div>
            <button
              type="button"
              id="clear-filters"
              class="mt-7 hidden text-sm font-medium text-wd-blue hover:underline"
            >
              Clear filters
            </button>
          </div>
        </aside>

        <div class="min-w-0 flex-1">
          <div class="relative">
            <svg
              class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400"
              viewBox="0 0 16 16"
              width="15"
              height="15"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <circle cx="7" cy="7" r="5"></circle>
              <path d="m14 14-3.5-3.5"></path>
            </svg>
            <input
              id="search"
              type="search"
              placeholder="Search examples..."
              aria-label="Search examples"
              class="w-full rounded-md border border-neutral-200 bg-white py-2.5 pl-10 pr-4 text-sm outline-none transition-colors placeholder:text-neutral-400 focus:border-wd-blue focus:ring-2 focus:ring-wd-blue/20 dark:border-neutral-800 dark:bg-black"
            />
          </div>

          <div id="cards" class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {examples.map((example) => <Card example={example} />)}
          </div>

          <div id="empty" class="hidden py-20 text-center">
            <p class="text-neutral-500 dark:text-neutral-400">No examples match those filters yet.</p>
            <p class="mt-1.5 text-sm">
              <a class="font-medium text-wd-blue hover:underline" href={contributeUrl} target="_blank" rel="noopener">
                Be the first to add one
              </a>
            </p>
          </div>
        </div>
      </div>
    </main>

    <Footer contributeUrl={contributeUrl} />

    <script>
      const searchInput = document.getElementById("search") as HTMLInputElement;
      const checkboxes = [...document.querySelectorAll("input[data-filter]")] as HTMLInputElement[];
      const cards = [...document.querySelectorAll(".example-card")] as HTMLElement[];
      const resultCount = document.getElementById("result-count")!;
      const emptyBlock = document.getElementById("empty")!;
      const clearButton = document.getElementById("clear-filters")!;

      const state = { query: "", type: new Set<string>(), component: new Set<string>(), product: new Set<string>() };

      const params = new URLSearchParams(location.search);
      state.query = (params.get("q") ?? "").toLowerCase();
      searchInput.value = state.query;
      const typeParam = params.get("type");
      if (typeParam) {
        for (const box of checkboxes) {
          if (box.dataset.filter === "type" && box.value === typeParam) box.checked = true;
        }
      }

      function readCheckboxes() {
        state.type.clear();
        state.component.clear();
        state.product.clear();
        for (const box of checkboxes) {
          if (box.checked) state[box.dataset.filter as "type" | "component" | "product"].add(box.value);
        }
      }

      function intersects(selected: Set<string>, values: string) {
        if (selected.size === 0) return true;
        return values.split("|").some((value) => selected.has(value));
      }

      function apply() {
        let visible = 0;
        for (const card of cards) {
          const matches =
            (state.type.size === 0 || state.type.has(card.dataset.type ?? "")) &&
            intersects(state.component, card.dataset.components ?? "") &&
            intersects(state.product, card.dataset.products ?? "") &&
            (!state.query || (card.dataset.search ?? "").includes(state.query));
          card.classList.toggle("hidden", !matches);
          if (matches) visible++;
        }
        resultCount.textContent = `Showing ${visible} of ${cards.length} examples`;
        emptyBlock.classList.toggle("hidden", visible > 0);
        const anyFilter = state.type.size + state.component.size + state.product.size > 0 || state.query !== "";
        clearButton.classList.toggle("hidden", !anyFilter);
      }

      for (const box of checkboxes) {
        box.addEventListener("change", () => {
          readCheckboxes();
          apply();
        });
      }

      clearButton.addEventListener("click", () => {
        for (const box of checkboxes) box.checked = false;
        searchInput.value = "";
        state.query = "";
        readCheckboxes();
        apply();
      });

      let timer: ReturnType<typeof setTimeout>;
      searchInput.addEventListener("input", () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          state.query = searchInput.value.trim().toLowerCase();
          apply();
        }, 150);
      });

      readCheckboxes();
      apply();
    </script>
  </body>
</html>
