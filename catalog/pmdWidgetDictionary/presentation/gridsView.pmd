{
  "id": "gridsView",
  "endPoints": [
    {
      "name": "countries",
      "baseUrlType": "wdayRef",
      "url": "/country/vers/latest/items?pageLimit=100",
      "authType": "sso",
      "bestEffort": "true",
      "isCollection": true
    },
   {
     "baseUrlType": "workday-staffing",
     "name": "workersPagedEndpoint",
     "authType": "sso",
     "url": "<%
       var limit = pagingVariables.limit ?: 100;
       var offset = pagingVariables.offset ?: 0;
       '/workers?limit=' + limit + '&offset=' + offset;
     %>"
   }
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "Grids - View Page"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "pod",
          "podId": "header"
        },
        {
          "type": "richText",
          "value": "Various grid configurations on a view page. Use tabs to navigate to the different grid configurations."
        }
      ]
    },
    "_footer": {
      "type": "footer",
      "children": [
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Grid",
        "children": [
          {
            "type": "text",
            "value": "A sample grid is below. This grid is generated using the Workday reference data API, to pull back countries. A sample re-direction button has also been added, which passes the countries id to a simple action:"
          },
          {
            "type": "grid",
            "id": "Countries",
            "rows": "<% countries.items %>",
            "rowVariableName": "country",
            "columns": [
              {
                "type": "column",
                "id": "country0",
                "columnId": "country0",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country.name %>"
                },
                "label": "Country Name"
              },
              {
                "type": "column",
                "id": "country1",
                "columnId": "country1",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country['ISO_3166_1_Alpha_2_Code'] %>"
                },
                "label": "ISO Alpha 2 Code"
              },
              {
                "type": "column",
                "id": "country2",
                "columnId": "country2",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country['ISO_3166_1_Alpha_3_Code'] %>"
                },
                "label": "ISO Alpha 3 Coder"
              },
              {
                "type": "column",
                "id": "country3",
                "columnId": "country3",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country['ISO_3166_1_Numeric_3_Code'] %>"
                },
                "label": "Numeric 3 Code"
              },
              {
                "type": "column",
                "id": "country4",
                "columnId": "country4",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country.defaultCurrency %>"
                },
                "label": "Currency"
              },
              {
                "type": "column",
                "id": "action",
                "columnId": "action",
                "label": "Sample Redirect with Query Parameter",
                "cellTemplate": {
                  "type": "button",
                  "label": "Go",
                  "action": "PRIMARY",
                  "taskReference": {
                    "taskId": "redirectQuery",
                    "parameterBindings": {
                      "id": "<% country['ISO_3166_1_Alpha_3_Code'] %>"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Sortable & Filterable Grid",
        "children": [
          {
            "type": "text",
            "value": "A sample grid that is configured with sortable and filterable columns. Also, export to excel is enabled."
          },
          {
            "excelExportEnabled": true,
            "type": "grid",
            "id": "Countries",
            "rows": "<% countries.items %>",
            "rowVariableName": "country",
            "columns": [
              {
                "type": "column",
                "id": "country0",
                "columnId": "country0_filter",
                "sortableAndFilterable": true,
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country.name %>"
                },
                "label": "Country Name"
              },
              {
                "type": "column",
                "id": "country1",
                "columnId": "country1_filter",
                "sortableAndFilterable": true,
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country['ISO_3166_1_Alpha_2_Code'] %>"
                },
                "label": "ISO Alpha 2 Code"
              },
              {
                "type": "column",
                "id": "country2",
                "columnId": "country2_filter",
                "sortableAndFilterable": true,
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country['ISO_3166_1_Alpha_3_Code'] %>"
                },
                "label": "ISO Alpha 3 Coder"
              },
              {
                "type": "column",
                "id": "country3",
                "columnId": "country3_filter",
                "sortableAndFilterable": true,
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country['ISO_3166_1_Numeric_3_Code'] %>"
                },
                "label": "Numeric 3 Code"
              },
              {
                "type": "column",
                "id": "country4",
                "columnId": "country4",
                "sortableAndFilterable": true,
                "cellTemplate": {
                  "type": "text",
                  "value": "<% country.defaultCurrency %>"
                },
                "label": "Currency"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Paginated Grid",
        "children": [
          {
            "type": "text",
            "value": "A grid with pagination configured. Additional pages are loaded as end user scrolls."
          },
          {
            "type": "grid",
            "label": "Workers",
            "rows": "<% workersPagedEndpoint.data %>",
            "rowVariableName": "worker",
            "pagingInfo": {
              "endPoint": "<% endpoints.workersPagedEndpoint %>",
              "rowCount": "<% workersPagedEndpoint.total %>",
              "data": "<% workersPagedEndpoint.data %>"
            },
            "columns": [
              {
                "type": "column",
                "label": "Worker",
                "columnId": "descriptor",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% worker.descriptor ?? '' %>"
                }
              },
              {
                "type": "column",
                "label": "Business Title",
                "columnId": "businessTitle",
                "cellTemplate": {
                  "type": "richText",
                  "value": "<% worker.primaryJob.businessTitle ?? '' %>"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}