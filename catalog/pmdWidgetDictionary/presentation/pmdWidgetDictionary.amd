{
  "appProperties": [],
  "flowDefinitions": [
    {
      "id": "calendarPopup",
      "flowSteps": [
        {
          "id": "startCalendarEventPopupMicro",
          "transitions": [
            {
              "order": "a",
              "value": "concludeCalendarEventPopupMicro",
              "condition": "true"
            }
          ],
          "startsFlow": true,
          "taskId": "popup"
        },
        {
          "id": "concludeCalendarEventPopupMicro",
          "endsFlow": true,
          "taskId": "micro"
        }
      ]
    },
    {
      "id": "calendarSubmitMicroFlow",
      "flowSteps": [
        {
          "id": "startCalendarSubmitMicro",
          "transitions": [
            {
              "order": "a",
              "value": "concludeCalendarSubmitMicro",
              "condition": "true"
            }
          ],
          "startsFlow": true,
          "taskId": "submit"
        },
        {
          "id": "concludeCalendarSubmitMicro",
          "endsFlow": true,
          "taskId": "micro"
        }
      ]
    },
    {
      "id": "microFirstPageFlow",
      "name": "microFirstPageFlow",
      "flowSteps": [
        {
          "id": "popup",
          "transitions": [
            {
              "order": "a",
              "value": "nextFull",
              "condition": "true"
            }
          ],
          "startsFlow": true,
          "taskId": "popupMicroFirst"
        },
        {
          "id": "nextFull",
          "taskId": "nextPage"
        }
      ]
    },
    {
      "id": "dropdownFlow",
      "flowSteps": [
        {
          "id": "dropdown",
          "transitions": [
            {
              "order": "a",
              "value": "dropdownHome",
              "condition": "true"
            }
          ],
          "taskId": "dropdown"
        },
        {
          "id": "dropdownHome",
          "taskId": "home"
        }
      ]
    },
    {
      "id": "simpleTypesFlow",
      "flowSteps": [
        {
          "id": "simpleTypes",
          "transitions": [
            {
              "order": "a",
              "value": "simpleTypesHome",
              "condition": "true"
            }
          ],
          "taskId": "simpleTypes"
        },
        {
          "id": "simpleTypesHome",
          "taskId": "home"
        }
      ]
    },
    {
      "id": "instanceListFlow",
      "flowSteps": [
        {
          "id": "instanceList",
          "transitions": [
            {
              "order": "a",
              "value": "instanceListHome",
              "condition": "true"
            }
          ],
          "taskId": "instanceList"
        },
        {
          "id": "instanceListHome",
          "taskId": "home"
        }
      ]
    },
    {
      "id": "extenderFlow",
      "flowSteps": [
        {
          "id": "extenderFlowStep1",
          "transitions": [
            {
              "id": "extenderFlowStep1a",
              "order": "a",
              "value": "extenderFlowStep2",
              "condition": "true"
            }
          ],
          "startsFlow": true,
          "taskId": "bpExtender"
        },
        {
          "id": "extenderFlowStep2",
          "endsFlow": true,
          "taskId": "bpExtenderConfirm"
        }
      ]
    },
        {
      "id": "taskMicroFlow",
      "flowSteps": [
        {
          "id": "taskMicroFlowStep1",
          "transitions": [
            {
              "id": "taskMicroFlowStep1a",
              "order": "a",
              "value": "taskMicroFlowStep2",
              "condition": "true"
            }
          ],
          "startsFlow": true,
          "taskId": "task"
        },
        {
          "id": "taskMicroFlowStep2",
          "endsFlow": true,
          "taskId": "microConclusion"
        }
      ]
    }
  ],
