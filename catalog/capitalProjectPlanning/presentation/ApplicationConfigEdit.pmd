    "responseErrorDetail": {
      "errorSummary": "<% error %>",
      "errors": "<% errors.map(item => {item.error}); %>"
    }
  },
  "onLoad": "<%
                if (!empty adaptiveSyncGET.data){
                pageVariables.adaptiveTaskTrigger = adaptiveSyncGET.data[0].planningTaskTrigger ?: null;
                var adaptiveTaskTriggerId = adaptiveSyncGET.data[0].planningTaskTrigger.id ?: '';
                var matchedRecord = planningTaskTriggersGET.data.find(record => record.id == adaptiveTaskTriggerId );
                
                pageVariables.adaptiveTaskCodeValue = matchedRecord ? matchedRecord.code : null;
                
                
                var adaptiveTaskId =  adaptiveSyncGET.data[0].adaptiveTaskId;
                var matchedTask = adaptiveTasksGET.find(record => record.id == adaptiveTaskId );
                
                pageVariables.currentAdaptiveTask = matchedTask ? matchedTask : null;
                }
                //console.info(bootstrapData.allBootstrapData.toJson());
               %>",
  "securityDomains": [
    "CapitalProjectPlanningAdministrator"
  ],
  "include": [
    "bootstrapData.script"
  ]
}