{
  "id": "AdaptiveSecretEdit",
  "endPoints": [],
  "presentation": {
    "title": {
      "type": "title",
      "label": "<% queryParams.pageTitle ? queryParams.pageTitle : 'Set Secret' %>"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "visible": "<%
                       if(queryParams.pageType=='ClientSecret'){
                          return true;
                       }else{
                           return false;
                       }
                      %>",
          "type": "fieldSet",
          "id": "fldClientSecret",
          "children": [
            {
              "render": "<% true %>",
              "required": "<%
                            if(queryParams.pageType=='ClientSecret'){
                              return true;
                            }else{
                               return false;
                            }
                           %>",
              "type": "text",
              "label": "Client Secret",
              "id": "clientSecretWidget",
              "valuesOut": [
                {
                  "value": "<% self.value %>",
                  "valueOutBinding": "adaptiveSync.clientSecret"
                }
              ]
            }
          ]
        },
        {
          "visible": "<%
                       if(queryParams.pageType=='RefreshToken'){
                          return true;
                       }else{
                           return false;
                       }
                      %>",
          "type": "fieldSet",
          "id": "fldRefreshToken",
          "children": [
            {
              "required": "<%
                            if(queryParams.pageType=='RefreshToken'){
                              return true;
                            }else{
                               return false;
                            }
                           %>",
              "type": "text",
              "id": "refreshTokenWidget",
              "label": "Refresh Token"
            }
          ]
        },
        {
          "visible": "<%
                       if(queryParams.pageType=='AdaptivePassword'){
                        return true;
                       }else{
                         return false;
                       }
                      %>",
          "type": "fieldSet",
          "id": "fldAdaptivePassword",
          "children": [
            {
              "required": "<%
                            if(queryParams.pageType=='AdaptivePassword'){
                             return true;
                            }else{
                              return false;
                            }
                           %>",
              "type": "text",
              "id": "adaptivePasswordWidget",
              "label": "Adaptive Password"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer"
    },
    "pageType": "EDIT",
    "micro": true
  },
  "outboundData": {
    "outboundEndPoints": [
      {
        "httpMethod": "PATCH",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/adaptiveSync/'+queryParams.adaptiveSyncId %>",
        "onSend": "<%
                                                 if(queryParams.pageType=='RefreshToken'){
                                                 return {\"refreshToken\": refreshTokenWidget.value}
                                                 }
                                                 
                                                 if(queryParams.pageType=='ClientSecret'){
                                                 return {\"clientSecret\": clientSecretWidget.value}
                                                 }
                                                 
                                                 if(queryParams.pageType=='AdaptivePassword'){
                                                 return {\"adaptiveCred\": adaptivePasswordWidget.value}
                                                 }
                                                %>",
        "name": "adaptiveSyncPATCH",
        "authType": "isu"
      }
    ]
  },
  "securityDomains": [
    "CapitalProjectPlanningAdministrator"
  ]
}