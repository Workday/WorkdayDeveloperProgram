{
  "id": "workEventActionStep",
  "include": [
    "fileTypes.script"
  ],
  "endPoints": [
    {
      "name": "bpEventStep",
      "baseUrlType": "workday-bp",
      "url": "<% //note the query param is mentioned in the pageRoute of the action step
              //in the .businessprocess file --> /review/{eventStepId}. Use this syntax to grab the eventStepId path parameter
              'eventSteps/' + queryParams.eventStepId %>",
      "authType": "sso"
    },
    {
      "name": "eventInfo",
      "baseUrlType": "workday-bp",
      "url": "<% //this endpoint is calling the Workday Business Processes REST API for information about a specific BP Event for our Model BP
              //use the event.id value from the bpEventStep response to get info about the Model BP Overall Event (overall process)
              //bpEventStep.event would give us information about the entire BP Event (aka the overall process)
              //not to be confused with the 'work event' Model BO we are acting on through our Model BP.
              //and the bpEventStep.event.id grabs the ID of the BP's target BO, in this case our Model BO for a work event

              'events/' + bpEventStep.event.id %>",
      "authType": "sso"
    },
    {
      "name": "workEventInfo",
      "baseUrlType": "app",
      "url": "<% //this endpoint calls our app's Model BO endpoint for work events, and uses the ID of the work event retrieved above
                //The ID of the Model BO in question is found in eventInfo['for'].id so calling this endpoint returns all the current Model BO data for that instace
              'workEvents/' + eventInfo['for'].id %>",
      "authType": "sso"
    },
    {
      "name": "userInfo",
      "baseUrlType": "workday-common",
      "url": "userInfo",
      "authType": "sso"
    },
    {
      "name": "me",
      "baseUrlType": "workday-common",
      "url": "workers/me",
      "authType": "sso"
    },
    {
      "name": "locationSearch",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "url": "<% var query = 'SELECT workdayID as id, locationName as descriptor , subordinateLocation{workdayID as id, locationName as descriptor} FROM locations (locationUsagesForLocation = (fbe0f826480e46978f80b361d35f31df, 46db411c4a5245fbb39834d8b2cba049)) WHERE subordinateLocation is not empty';
              console.info(query);
              return 'data?query=' + query.urlEncode(); %>"
    },
    {
      "name": "subLocationSearch",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "url": "<% var query = 'SELECT subordinateLocation{workdayID as id, locationName as descriptor} FROM locations (locationUsagesForLocation = (fbe0f826480e46978f80b361d35f31df, 46db411c4a5245fbb39834d8b2cba049)) WHERE location=' + locationsInstanceList.promptSelections[0] + ' and subordinateLocation is not empty';
              console.info(query);
              return 'data?query=' + query.urlEncode(); %>",
      "deferred": "true"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "workEventPATCH",
        "baseUrlType": "app",
        "url": "workEvents/<% eventInfo['for'].id %>",
        "httpMethod": "PATCH",
        "authType": "sso",
        "onSend": "<% console.info(json:asJSON(self.data)); return self.data; %>"
      },
      {
        "name": "submitStep",
        "baseUrlType": "workday-bp",
        "url": "eventSteps/<% queryParams.eventStepId %>/submit",
        "httpMethod": "POST",
        "authType": "sso",
        "onSend": "<% console.info(json:asJSON(self.data)); return self.data; %>",
        "values": [
          {
            "outboundPath": "stepAction.id",
            "value": "<% //this action page is ultimately just a PMD; when the information is submitted we need to
                      //advance the BP by calling the BP event with this exact value, which corresponds to the 'submit' step action ID
                      //this WID corrresponds to the step action ID of 'submitted'
                      'd9e4223e446c11de98360015c5e6daf6' %>"
          }
        ]
      }
    ]
  },
  "presentation": {
    "title": {
      "label": "Work Event Request Details",
      "type": "title"
    },
    "headerSize": "STANDARD",
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "richText",
          "value": "<hr>",
          "enabled": false
        },
        {
          "type": "section",
          "title": "This event has been approved. Please book an office location for the event and submit.",
          "horizontal": false,
          "children": [
            {
              "_comment": "Prompt for Location and the value selected will be passed",
              "type": "instanceList",
              "id": "locationsInstanceList",
              "multiSelect": "false",
              "label": "Select an Event Venue",
              "required": "<% true %>",
              "values": "<% locationSearch.data %>",
              "monikerLevels": [
                {
                  "type": "monikerLevel",
                  "levelValues": "<% subLocationSearch.data[0].subordinateLocation %>",
                  "endPoint": "<% endpoints.subLocationSearch %>"
                }
              ],
              "valueOutBinding": "workEventPATCH.venue.id"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "richText",
          "enabled": "false",
          "value": "Powered By<br/><b>Workday Extend 🎟️</b>"
        }
      ]
    }
  }
}