{
  "id": "featureLayouts",
  "include": [
    "cookieData.script"
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "Layouts"
    },
    "body": {
      "type": "section",
      "children": [
        {
          "type": "fieldSet",
          "horizontal": true,
          "collapsible": true,
          "title": "Horizontal Fieldset with 6 charts",
          "children": [
            {
              "type": "fieldSet",
              "title": "FieldSet 1",
              "children": [
                {
                  "type": "clusteredBarChart2",
                  "barOrientation": "VERTICAL",
                  "id": "chart1",
                  "data": "<% cookieData.getCookieData() %>",
                  "dataVariableName": "data",
                  "measurementDataSets": [
                    {
                      "name": "Num Boxes Sold",
                      "value": "<% data['actualSales'] %>"
                    },
                    {
                      "name": "Sales Goal",
                      "value": "<% data['salesGoal'] %>"
                    },
                    {
                      "name": "Troop Avg.",
                      "value": "<% data['troopAverage'] %>"
                    }
                  ],
                  "categoryDataSet": {
                    "name": "Cookie Type",
                    "value": "<% data['cookieType'] %>"
                  }
                }
              ]
            },
            {
              "type": "fieldSet",
              "title": "FieldSet 2",
              "children": [
                {
                  "type": "clusteredBarChart2",
                  "barOrientation": "HORIZONTAL",
                  "id": "chart2",
                  "data": "<% cookieData.getCookieData() %>",
                  "dataVariableName": "data",
                  "measurementDataSets": [
                    {
                      "name": "Num Boxes Sold",
                      "value": "<% data['actualSales'] %>"
                    },
                    {
                      "name": "Sales Goal",
                      "value": "<% data['salesGoal'] %>"
                    },
                    {
                      "name": "Troop Avg.",
                      "value": "<% data['troopAverage'] %>"
                    }
                  ],
                  "categoryDataSet": {
                    "name": "Cookie Type",
                    "value": "<% data['cookieType'] %>"
                  }
                }
              ]
            },
            {
              "type": "fieldSet",
              "title": "FieldSet 3",
              "children": [
                {
                  "type": "clusteredBarChart2",
                  "barOrientation": "VERTICAL",
                  "id": "chart3",
                  "data": "<% cookieData.getCookieData() %>",
                  "dataVariableName": "data",
                  "measurementDataSets": [
                    {
                      "name": "Num Boxes Sold",
                      "value": "<% data['actualSales'] %>"
                    },
                    {
                      "name": "Sales Goal",
                      "value": "<% data['salesGoal'] %>"
                    },
                    {
                      "name": "Troop Avg.",
                      "value": "<% data['troopAverage'] %>"
                    }
                  ],
                  "categoryDataSet": {
                    "name": "Cookie Type 3",
                    "value": "<% data['cookieType'] %>"
                  }
                }
              ]
            },
            {
              "type": "fieldSet",
              "title": "FieldSet 4",
              "children": [
                {
                  "type": "clusteredBarChart2",
                  "barOrientation": "HORIZONTAL",
                  "id": "chart4",
                  "data": "<% cookieData.getCookieData() %>",
                  "dataVariableName": "data",
                  "measurementDataSets": [
                    {
                      "name": "Num Boxes Sold",
                      "value": "<% data['actualSales'] %>"
                    },
                    {
                      "name": "Sales Goal",
                      "value": "<% data['salesGoal'] %>"
                    },
                    {
                      "name": "Troop Avg.",
                      "value": "<% data['troopAverage'] %>"
                    }
                  ],
                  "categoryDataSet": {
                    "name": "Cookie Type 4",
                    "value": "<% data['cookieType'] %>"
                  }
                }
              ]
            },
            {
              "type": "fieldSet",
              "title": "FieldSet 5",
              "children": [
                {
                  "type": "clusteredBarChart2",
                  "barOrientation": "VERTICAL",
                  "id": "chart5",
                  "data": "<% cookieData.getCookieData() %>",
                  "dataVariableName": "data",
                  "measurementDataSets": [
                    {
                      "name": "Num Boxes Sold",
                      "value": "<% data['actualSales'] %>"
                    },
                    {
                      "name": "Sales Goal",
                      "value": "<% data['salesGoal'] %>"
                    },
                    {
                      "name": "Troop Avg.",
                      "value": "<% data['troopAverage'] %>"
                    }
                  ],
                  "categoryDataSet": {
                    "name": "Cookie Type 5",
                    "value": "<% data['cookieType'] %>"
                  }
                }
              ]
            },
            {
              "type": "fieldSet",
              "title": "FieldSet 6",
              "children": [
                {
                  "type": "clusteredBarChart2",
                  "barOrientation": "HORIZONTAL",
                  "id": "chart6",
                  "data": "<% cookieData.getCookieData() %>",
                  "dataVariableName": "data",
                  "measurementDataSets": [
                    {
                      "name": "Num Boxes Sold",
                      "value": "<% data['actualSales'] %>"
                    },
                    {
                      "name": "Sales Goal",
                      "value": "<% data['salesGoal'] %>"
                    },
                    {
                      "name": "Troop Avg.",
                      "value": "<% data['troopAverage'] %>"
                    }
                  ],
                  "categoryDataSet": {
                    "name": "Cookie Type 6",
                    "value": "<% data['cookieType'] %>"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "fieldSet",
          "collapsible": true,
          "title": "Chart in Panel List",
          "children": [
            {
              "type": "panelList",
              "label": "Panel List with Chart",
              "panels": "<% [11, 22, 33] %>",
              "panelName": "panel",
              "indexVariableName": "i",
              "children": [
                {
                  "type": "text",
                  "label": "Text Field",
                  "value": "<% 'Panel Index: ' + i %>"
                },
                {
                  "type": "date",
                  "label": "Date Field",
                  "value": "<% date:now().format('yyyy-MM-dd') %>"
                },
                {
                  "type": "clusteredBarChart2",
                  "barOrientation": "VERTICAL",
                  "id": "chartPanel",
                  "data": "<% cookieData.getCookieData() %>",
                  "dataVariableName": "data",
                  "measurementDataSets": [
                    {
                      "name": "Num Boxes Sold",
                      "value": "<% data['actualSales'] %>"
                    },
                    {
                      "name": "Sales Goal",
                      "value": "<% data['salesGoal'] %>"
                    },
                    {
                      "name": "Troop Avg.",
                      "value": "<% data['troopAverage'] %>"
                    }
                  ],
                  "categoryDataSet": {
                    "name": "Cookie Type - Panel List",
                    "value": "<% data['cookieType'] %>"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}