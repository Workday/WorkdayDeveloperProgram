{
  "id": "featureSecondaryCategory",
  "include": [
    "cookieData.script"
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "Additional Category Data"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "section",
          "title": "Multiple Measurements, Single Category (Cookie Type)",
          "children": [
            {
              "type": "clusteredBarChart2",
              "barOrientation": "VERTICAL",
              "id": "chart1",
              "data": "<% cookieData.getCookieData() %>",
              "dataVariableName": "data",
              "measurementDataSets": [
                {
                  "name": "Num Boxes Sold",
                  "value": "<% data['actualSales'] %>"
                },
                {
                  "name": "Sales Goal",
                  "value": "<% data['salesGoal'] %>"
                },
                {
                  "name": "Troop Avg.",
                  "value": "<% data['troopAverage'] %>"
                }
              ],
              "categoryDataSet": {
                "name": "Cookie Type",
                "value": "<% data['cookieType'] %>"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Single Measurement, Primary Category (Cookie Type), and Secondary Category (Seller)",
          "children": [
            {
              "type": "clusteredBarChart2",
              "barOrientation": "VERTICAL",
              "id": "chart2",
              "data": "<% cookieData.getSellerCookieData() %>",
              "dataVariableName": "data",
              "measurementDataSets": [
                {
                  "name": "Num Boxes Sold",
                  "value": "<% data['actualSales'] %>"
                }
              ],
              "categoryDataSet": {
                "name": "Cookie Type",
                "value": "<% data['cookieType'] %>"
              },
              "secondaryCategory": {
                "name": "Seller",
                "value": "<% data['sellerName'] %>"
              }
            }
          ]
        }
      ]
    }
  }
}