{
  "id": "lineChart2",
  "include": [
    "cookieData.script"
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "Line Charts"
    },
    "body": {
      "type": "section",
      "children": [
        {
          "type": "section",
          "title": "Simple Line Chart",
          "children": [
            {
              "type": "lineChart2",
              "id": "chart1",
              "data": "<% cookieData.getCookieData() %>",
              "dataVariableName": "data",
              "measurementDataSets": [
                {
                  "name": "Num Boxes Sold",
                  "value": "<% data.actualSales %>"
                },
                {
                  "name": "Sales Goal",
                  "value": "<% data.salesGoal %>"
                },
                {
                  "name": "Troop Avg.",
                  "value": "<% data.troopAverage %>"
                }
              ],
              "categoryDataSet": {
                "name": "Cookie Type",
                "value": "<% data.cookieType %>"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Line Chart - chartMarkLabels, legend to the right",
          "children": [
            {
              "type": "lineChart2",
              "id": "chart2",
              "data": "<% cookieData.getCookieData() %>",
              "dataVariableName": "data",
              "legendPosition": "RIGHT",
              "measurementDataSets": [
                {
                  "name": "Num Boxes Sold",
                  "value": "<% data.actualSales %>",
                  "chartMarkLabel": "<% data.actualSales %>"
                },
                {
                  "name": "Sales Goal",
                  "value": "<% data.salesGoal %>"
                },
                {
                  "name": "Troop Avg.",
                  "value": "<% data.troopAverage %>"
                }
              ],
              "categoryDataSet": {
                "name": "Cookie Type",
                "value": "<% data.cookieType %>"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Line Chart - comparison line",
          "children": [
            {
              "type": "lineChart2",
              "id": "chart3",
              "data": "<% cookieData.getCookieData() %>",
              "dataVariableName": "data",
              "measurementDataSets": [
                {
                  "name": "Num Boxes Sold",
                  "value": "<% data.actualSales %>"
                },
                {
                  "name": "Sales Goal",
                  "value": "<% data.salesGoal %>"
                },
                {
                  "name": "Troop Avg.",
                  "value": "<% data.troopAverage %>"
                }
              ],
              "categoryDataSet": {
                "name": "Cookie Type",
                "value": "<% data.cookieType %>"
              },
              "measurementAxisOptions": {
                "comparisonLineLabel": "Last year's troop average",
                "comparisonLineValue": 50
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Line Chart - axis options: min, max, hide category axis values",
          "children": [
            {
              "type": "lineChart2",
              "id": "chart4",
              "data": "<% cookieData.getCookieData() %>",
              "dataVariableName": "data",
              "measurementDataSets": [
                {
                  "name": "Num Boxes Sold",
                  "value": "<% data.actualSales %>"
                },
                {
                  "name": "Sales Goal",
                  "value": "<% data.salesGoal %>"
                },
                {
                  "name": "Troop Avg.",
                  "value": "<% data.troopAverage %>"
                }
              ],
              "categoryDataSet": {
                "name": "Cookie Type",
                "value": "<% data.cookieType %>"
              },
              "categoryAxisOptions": {
                "hideAxisValues": true
              },
              "measurementAxisOptions": {
                "axisMinimum": 10,
                "axisMaximum": 100
              }
            }
          ]
        }
      ]
    }
  }
}