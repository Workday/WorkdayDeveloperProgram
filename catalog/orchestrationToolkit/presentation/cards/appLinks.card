{
    "id": "appLinks",
    "parameters": ["title", "body", "taskRef", "taskLabel"],
    "header": {
        "title": "<% title %>"
    },
    "body": {
        "type": "simpleCard",
        "value": "<% body %>"
    },
    "footer": [
        {
            "label": "<% taskLabel %>",
            "taskReference": {
                "taskId": "<% taskRef %>"
            }
        }
    ]
}
