{
  "_pagePurpose1": "This page allows for both successful and failed bulk transactions. It uses an Orchestration in order to send more than 100 records",
  "_pagePurpose2": "Any errors will be surfaced back to the user, using a page flow and response inspection. This is great for bulk error handling!",
  "id": "testOrchestrateBulkErrors",
  "script": "<%
             const getGridRowsWithStatus = function(){
                // Get the Grid data and prepare a simplified format for passing to the next page
                const myGridRows = bulkRows.getRows();
                const newGridRows = myGridRows.map(row => { 
                 {
                    'column1': row.childrenMap.colStart.value[0] ?? '',
                    'column2': row.childrenMap.colHandoff.value[0] ?? '',
                    'status' : 201,
                    'message' : 'good'
                 } 
                });

                // Now loop through the responses, applying the correct response to each row from the grid
                let rowCounter = 0;

                for (let newRow : newGridRows) {
                  const postRow = workerPOST.data[rowCounter];
                  newRow.status = postRow.status;

                  if (newRow.status != 201) { 
                    newRow.message = postRow.body.error; 
                  }

                  rowCounter += 1;
                }

                // Now filter out the grid rows that went through, and only pass the error records back
                const failureRows = newGridRows.filter(tempRow => {tempRow.status != 201});
                return failureRows
             }
            %>",
  "endPoints": [
    {
      "baseUrlType": "workday-common",
      "name": "allWorkers",
      "authType": "sso",
      "url": "workers?limit=100"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "baseUrlType": "workday-orchestration",
        "name": "workerPOST",
        "authType": "sso",
        "url": "bulkErrorsMultiPage/launch",
        "httpMethod": "POST",
        "onSend": "<% 
          const postData = {'data': self.data};
          return postData;
        %>"
      },
      {
        "type": "outboundVariable",
        "name": "RestResponse",
        "variableScope": "flow",
        "values": [
          {
            "outboundPath": "wholeResponse",
            "value": "<% json:asJSON(workerPOST) %>"
          },
          {
            "outboundPath": "StatusFlagError",
            "value": "<% return !empty workerPOST.data.find(entry => {entry.status != 201}); %>"
          },
          {
            "outboundPath": "RowsMap",
            "value": "<% getGridRowsWithStatus(); %>"
          }
        ]
      }
    ]
  },
  "presentation": {
    "title": {
      "type": "title",
      "label": "Test Orchestrate Bulk Error Handling"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "richText",
          "enabled": false,
          "label": "Enter some Rows Below",
          "value": "If you are logged in as <b>Logan</b> and gave <b>Manager</b> modify permissions on the <b>BulkWorkersDomain</B> security domain, using Logan's direct reports in the Starting Worker column will go through and anyone else will not (Betty Liu is a good example). Good records will be saved. If there are error records you will be rerouted to this page with the good records removed, and the error records presented with the error code. Fix the errors and click OK again to reprocess."
        },
        {
          "type": "text",
          "enabled": false,
          "label": "Limits",
          "value": "Please use this design pattern when you expect to have to deal with more than 100 records in the grid.  It will certainly handle requests with less than 100 records, but is needlessly complex for smaller data sets."
        },
        {
          "type": "pageActionButton",
          "label": "Prepopulate 100 rows",
          "onClick": "<%
                   if (empty(flowVariables.RowsMap)){
                       const workerRows = allWorkers.data;
                       const newGridRows = workerRows.map(tempRow => { 
                        {
                          'column1': tempRow.id,
                          'column2': tempRow.id,
                          'status' : 000
                        } 
                      });
                       bulkRows.setRows(newGridRows);
                   }
                   %>"
        },
        {
          "type": "grid",
          "id": "bulkRows",
          "rows": "<% flowVariables.RowsMap %>",
          "isArrayOutBinding": true,
          "rowVariableName": "rosterRow",
          "columns": [
            {
              "type": "column",
              "columnId": "colStart",
              "label": "Starting Worker",
              "cellTemplate": {
                "type": "dropdown",
                "values": "<% allWorkers.data %>",
                "valueOutBinding": "workerPOST.[].workerStarter.id",
                "selectedValues": "<% [rosterRow.column1] ?? []  %>"
              }
            },
            {
              "type": "column",
              "columnId": "colHandoff",
              "label": "Handoff Worker",
              "cellTemplate": {
                "type": "dropdown",
                "values": "<% allWorkers.data %>",
                "valueOutBinding": "workerPOST.[].workerHandoff.id",
                "selectedValues": "<% [rosterRow.column2] ?? []  %>"
              }
            },
            {
              "type": "column",
              "columnId": "colStatus",
              "label": "Status",
              "cellTemplate": {
                "type": "text",
                "value": "<% rosterRow.status ?? ''  %>",
                "enabled": false
              }
            },
            {
              "type": "column",
              "columnId": "colMessage",
              "label": "Error Message",
              "cellTemplate": {
                "type": "text",
                "value": "<% rosterRow.message ?? ''  %>",
                "enabled": false
              }
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "richText",
          "enabled": "false",
          "value": "Powered By Workday Extend"
        }
      ]
    }
  }
}