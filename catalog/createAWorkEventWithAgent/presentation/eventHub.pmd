          }
        },
        {
          "type": "item",
          "icon": "wd-icon-time-off-balance",
          "label": "Manage Events",
          "task": {
            "taskId": "manageEvents"
          }
        }
      ],
      "additionalLinks": {
        "title": "Create New Work Events",
        "links": [
          {
            "type": "task",
