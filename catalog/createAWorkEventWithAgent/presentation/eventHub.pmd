{
  "id": "eventHub",
  "securityDomains": [
    "RegisterForEvents"
  ],
  "presentation": {
    "body": {
      "type": "hub",
      "label": "Work Event Registration",
      "initialTask": {
        "taskId": "home"
      },
      "navigationTasks": [
        {
          "type": "item",
          "icon": "wd-icon-timeline-milestone",
          "label": "About",
          "task": {
            "taskId": "home"
          }
        },
        {
          "type": "item",
          "icon": "wd-icon-search-user",
          "label": "Register For Events",
