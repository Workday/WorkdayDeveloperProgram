{
  "appProperties": [ ],
  "flowDefinitions": [
    {
      "id": "caseFlow",
      "name": "caseFlow",
      "flowSteps": [
        {
          "id": "viewProtectedCaseStep",
          "taskId": "viewProtectedCase"
        },
        {
          "id": "addProtectedCommentStep",
          "transitions": [
            {
              "order": "a",
              "value": "viewProtectedCaseStep",
              "condition": "true"
            }
          ],
          "taskId": "addProtectedComment"
        },
        {
          "id": "protectedCase_NewStep",
          "transitions": [
            {
              "order": "a",
              "value": "protectedCase_EditStep",
              "condition": "true"
            }
          ],
          "taskId": "protectedCase_New"
        },
        {
          "id": "protectedCase_EditStep",
          "transitions": [
            {
              "order": "a",
              "value": "viewProtectedCaseStep",
              "condition": "true"
            }
          ],
          "taskId": "protectedCase_Edit"
        },
        {
          "id": "editProtectedCommentStep",
          "transitions": [
            {
              "order": "a",
              "value": "viewProtectedCaseStep",
              "condition": "true"
            }
          ],
          "taskId": "editProtectedComment"
        }
      ]
    },
    {
      "id": "deleteFlow",
      "name": "deleteFlow",
      "flowSteps": [
        {
          "id": "deleteFlowStep1",
          "transitions": [
            {
              "order": "a",
              "value": "deleteFlowStep2",
              "condition": "true"
            }
          ],
          "taskId": "deleteProtectedCases"
        },
        {
          "id": "deleteFlowStep2",
          "taskId": "deleteProtectedCases_Confirm"
        }
      ]
    },
    {
      "id": "exportFlow",
      "name": "exportFlow",
      "flowSteps": [
        {
          "id": "exportFlowStep1",
          "transitions": [
            {
              "order": "a",
              "value": "exportFlowStep2",
              "condition": "true"
            }
          ],
          "taskId": "exportMicroPopup"
        },
        {
          "id": "exportFlowStep2",
          "taskId": "viewProtectedCase"
        }
      ]
    }
  ],
  "tasks": [
