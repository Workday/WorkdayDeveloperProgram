{
  "id": 1,
  "name": "CreditCardRequest",
  "label": "Credit Card Request",
  "defaultSecurityDomains": [
    "ManageCreditCardRequests"
  ],
  "defaultCollection": {
    "name": "creditCardRequests",
    "label": "All Credit Card Requests", 
    "description": "Displays all credit card requests"
    
  },
  "fields": [
    {
      "id": 1,
      "name": "cardAssignee",
